<odoo>
    <record id="gtve_document_form_view" model="ir.ui.view">
        <field name="name">gtve.document.form.view (in l10n_br_gtve)</field>
        <field name="model">l10n_br_fiscal.document</field>
        <field name="inherit_id" ref="l10n_br_fiscal.document_form" />
        <field name="arch" type="xml">
            <page name="delivery" position="after">
                <page name="gtve" string="GTV-e" invisible="document_type != '64'">
                    <group>
                        <group name="gtve_parties">
                            <field name="partner_sendering_id" string="Sender" />
                            <field name="gtve_service_taker" />
                            <field name="cte40_indIEToma" />
                        </group>
                        <group name="gtve_transport">
                            <field name="transport_modal" />
                            <field name="gtve_cfop_id" />
                            <field name="gtve_departure_date" />
                            <field name="gtve_arrival_date" />
                            <field name="gtve_load_quantity" />
                        </group>
                    </group>
                    <field name="gtve_species_ids">
                        <list editable="bottom">
                            <field name="cte40_tpEspecie" />
                            <field name="cte40_tpNumerario" />
                            <field name="cte40_xMoedaEstr" />
                            <field name="brl_currency_id" column_invisible="True" />
                            <field name="cte40_vEspecie" />
                        </list>
                    </field>
                    <field name="gtve_vehicle_ids">
                        <list editable="bottom">
                            <field name="cte40_placa" />
                            <field name="cte40_UF" />
                            <field name="cte40_RNTRC" />
                        </list>
                    </field>
                </page>
            </page>
        </field>
    </record>
</odoo>
