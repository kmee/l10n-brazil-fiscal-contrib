<odoo>
    <record id="bpe_res_company_form" model="ir.ui.view">
        <field name="name">res.company.form (in l10n_br_bpe)</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="l10n_br_fiscal.fiscal_res_company_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='fiscal']/notebook" position="inside">
                <page name="bpe" string="BP-e">
                    <group name="bpe_settings" string="BP-e Default Settings">
                        <field name="bpe_environment" required="1" />
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
