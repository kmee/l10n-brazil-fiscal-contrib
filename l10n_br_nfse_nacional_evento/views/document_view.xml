<odoo>
    <record id="document_form" model="ir.ui.view">
        <field name="name">l10n_br_fiscal.document.form (nfse evento)</field>
        <field name="model">l10n_br_fiscal.document</field>
        <field name="inherit_id" ref="l10n_br_fiscal.document_form" />
        <field name="arch" type="xml">
            <page name="extra_info" position="before">
                <page
                    name="nfse_event"
                    string="Event"
                    invisible="document_type != 'SE'"
                >
                    <group>
                        <group>
                            <field name="nfse_event_name" />
                            <field name="nfse_event_date_start" />
                            <field name="nfse_event_date_end" />
                        </group>
                        <group>
                            <field name="nfse_event_code" />
                            <field
                                name="nfse_event_partner_id"
                                invisible="nfse_event_code"
                            />
                        </group>
                    </group>
                </page>
            </page>
        </field>
    </record>
</odoo>
