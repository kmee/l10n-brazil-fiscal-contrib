<odoo>
    <record id="dce_res_company_form" model="ir.ui.view">
        <field name="name">res.company.form (in l10n_br_dce)</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="l10n_br_fiscal.fiscal_res_company_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='fiscal']/notebook" position="inside">
                <page name="dce" string="DC-e">
                    <group name="dce_settings" string="DC-e Default Settings">
                        <field name="dce_environment" required="1" />
                        <field name="dce_issuer_type" required="1" />
                        <field
                            name="dce_marketplace_site"
                            invisible="dce_issuer_type != '1'"
                        />
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
