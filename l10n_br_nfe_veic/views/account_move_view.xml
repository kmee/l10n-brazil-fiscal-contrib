<odoo>
    <record id="invoice_form" model="ir.ui.view">
        <field name="name">account.move.form (veicProd)</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="l10n_br_account.invoice_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='invoice_line_ids']/form//page[@name='fiscal_line_extra_info']"
                position="before"
            >
                <page name="nfe40_veicProd" string="New Vehicle">
                    <group>
                        <field
                            name="nfe40_veicProd"
                            context="{'form_view_ref': 'l10n_br_nfe_veic.nfe_veicprod_form'}"
                        />
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
