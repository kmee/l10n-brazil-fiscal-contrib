<odoo>
    <record model="ir.ui.view" id="res_company_form_view">
        <field name="name">res.company.form (in l10n_br_nfeabi)</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="l10n_br_fiscal.fiscal_res_company_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='fiscal']/notebook" position="inside">
                <page name="nfeabi" string="NF-e ABI">
                    <group name="nfeabi_settings">
                        <field name="nfeabi_environment" required="1" />
                        <field name="nfeabi_qrcode_url" />
                        <field name="nfeabi_key_query_url" />
                        <field name="nfeabi_technical_partner_id" />
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
