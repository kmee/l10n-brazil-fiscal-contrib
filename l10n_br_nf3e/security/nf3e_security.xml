<odoo>
    <record id="module_category_l10n_br_nf3e" model="ir.module.category">
        <field name="name">NF3e</field>
        <field name="sequence">30</field>
    </record>

    <record id="group_user" model="res.groups">
        <field name="name">NF3e User</field>
        <field name="category_id" ref="module_category_l10n_br_nf3e" />
    </record>

    <record id="group_manager" model="res.groups">
        <field name="name">NF3e Manager</field>
        <field name="implied_ids" eval="[Command.link(ref('group_user'))]" />
        <field name="category_id" ref="module_category_l10n_br_nf3e" />
    </record>

    <record id="base.user_admin" model="res.users">
        <field name="groups_id" eval="[Command.link(ref('group_manager'))]" />
    </record>
</odoo>
