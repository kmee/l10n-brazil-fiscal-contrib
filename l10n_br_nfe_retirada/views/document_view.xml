<odoo>
    <record id="document_form" model="ir.ui.view">
        <field name="name">l10n_br_fiscal.document.form (retirada)</field>
        <field name="model">l10n_br_fiscal.document</field>
        <field name="inherit_id" ref="l10n_br_nfe.nfe_document_form_inherit" />
        <field name="arch" type="xml">
            <group name="nfe_transport" position="before">
                <group name="nfe40_retirada" invisible="document_type != '55'">
