<odoo>
    <record id="document_form" model="ir.ui.view">
        <field name="name">l10n_br_fiscal.document.form (nfse obra)</field>
        <field name="model">l10n_br_fiscal.document</field>
        <field name="inherit_id" ref="l10n_br_fiscal.document_form" />
        <field name="arch" type="xml">
            <page name="extra_info" position="before">
                <page
                    name="nfse_obra"
                    string="Construction Work"
                    invisible="document_type != 'SE'"
                >
                    <group>
                        <field name="nfse_obra_partner_id" />
                        <field name="civil_construction_code" string="CNO/CEI" />
                        <field name="nfse_obra_cib" />
                        <field name="nfse_obra_insc_imob_fisc" />
                    </group>
                </page>
            </page>
        </field>
    </record>
</odoo>
