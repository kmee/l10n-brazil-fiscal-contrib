<odoo>
    <record id="bpe_ta_document_line_form_view" model="ir.ui.view">
        <field name="name">l10n_br_fiscal.document.line.form (in l10n_br_bpe_ta)</field>
        <field name="model">l10n_br_fiscal.document.line</field>
        <field name="inherit_id" ref="l10n_br_fiscal.document_line_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="bpe_ta" string="BP-e TA" invisible="bpe_layout != 'ta'">
                    <field name="bpe_layout" invisible="1" />
                    <group>
                        <field name="bpe_ta_component_type" />
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
