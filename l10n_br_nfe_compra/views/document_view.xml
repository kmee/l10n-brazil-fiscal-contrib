<odoo>
    <record id="document_form" model="ir.ui.view">
        <field name="name">l10n_br_fiscal.document.form (compra)</field>
        <field name="model">l10n_br_fiscal.document</field>
        <field name="inherit_id" ref="l10n_br_nfe.nfe_document_edi_form_inherit" />
        <field name="arch" type="xml">
            <group name="nfe_autxml" position="before">
                <group
                    name="nfe40_compra"
                    string="Purchase Information"
                    attrs="{'invisible': [('document_type', '!=', '55')]}"
                >
                    <field name="purchase_commitment_note" />
                    <field name="purchase_order_ref" />
                    <field name="purchase_contract_ref" />
                </group>
            </group>
        </field>
    </record>
</odoo>
