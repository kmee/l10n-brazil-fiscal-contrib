<odoo>
    <record id="document_form" model="ir.ui.view">
        <field name="name">l10n_br_fiscal.document.form (cana)</field>
        <field name="model">l10n_br_fiscal.document</field>
        <field name="inherit_id" ref="l10n_br_fiscal.document_form" />
        <field name="arch" type="xml">
            <page name="extra_info" position="before">
                <page
                    name="nfe40_cana"
                    string="Sugarcane"
                    invisible="document_type != '55'"
                >
                    <group>
                        <field
                            name="nfe40_cana"
                            context="{'form_view_ref': 'l10n_br_nfe_cana.nfe_cana_form'}"
                        />
                    </group>
                </page>
            </page>
        </field>
    </record>
</odoo>
