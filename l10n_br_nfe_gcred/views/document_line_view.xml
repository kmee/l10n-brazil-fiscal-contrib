<odoo>
    <record id="document_line_form" model="ir.ui.view">
        <field name="name">l10n_br_fiscal.document.line.form (gcred)</field>
        <field name="model">l10n_br_fiscal.document.line</field>
        <field name="inherit_id" ref="l10n_br_fiscal.document_line_form" />
        <field name="arch" type="xml">
            <page name="fiscal_line_extra_info" position="before">
                <page name="nfe40_gCred" string="Presumed Credit">
                    <field
                        name="nfe40_gCred"
                        context="{'tree_view_ref': 'l10n_br_nfe_gcred.nfe_gcred_list'}"
                    />
                </page>
            </page>
        </field>
    </record>
</odoo>
