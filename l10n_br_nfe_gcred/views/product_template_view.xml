<odoo>
    <record id="product_template_form" model="ir.ui.view">
        <field name="name">product.template.form (gcred)</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="l10n_br_fiscal.product_template_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='fiscal']/group" position="after">
                <group name="nfe_cred_presumido" string="ICMS Presumed Credit">
                    <field name="nfe_cred_presumido_code" />
                    <field name="nfe_cred_presumido_percent" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
