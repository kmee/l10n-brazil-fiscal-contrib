<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="document_form" model="ir.ui.view">
        <field name="name">l10n_br_nfcom.document.form</field>
        <field name="model">l10n_br_fiscal.document</field>
        <field name="inherit_id" ref="l10n_br_fiscal_edi.document_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='others']" position="before">
                <page name="nfcom" string="NFCom" invisible="document_type != '62'">
                    <group>
                        <group string="Subscriber">
                            <field name="nfcom10_iCodAssinante" />
                            <field name="nfcom10_tpAssinante" />
                            <field name="nfcom10_tpServUtil" />
                            <field name="nfcom10_nContrato" />
                            <field name="nfcom10_dContratoIni" />
                            <field name="nfcom10_dContratoFim" />
                            <field name="nfcom10_NroTermPrinc" />
                            <field name="nfcom10_cUFPrinc" />
                        </group>
                        <group string="Issue">
                            <field name="nfcom_environment" />
                            <field name="nfcom10_finNFCom" />
                            <field name="nfcom10_tpFat" />
                            <field name="nfcom10_tpEmis" />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
